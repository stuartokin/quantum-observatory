{
  "name": "scout",
  "description": "Horizons 1 and 2. Mainstream and emerging quantum developments. Proposes new frontier items with primary sources.",
  "model": "claude-sonnet-4-6",
  "everyWeeks": 1,
  "write_scope": [
    "content/frontier/_inbox/**",
    "content/questions/**"
  ],
  "output": "pull_request",
  "enabled": true,
  "budget": {
    "searches": 25,
    "proposals": 4
  },
  "maxTokens": 32000,
  "fixedCollections": [
    "questions"
  ]
}
