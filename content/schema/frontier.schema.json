{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://horizonqltd.com/schema/frontier/v1",
  "title": "Horizon Q frontier item",
  "description": "One development on the frontier. Position is derived from readiness; nothing here stores coordinates. No item exists without a source.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "pillar",
    "readiness",
    "evidence",
    "confidence",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frontier/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "plain": {
      "type": "string",
      "maxLength": 600,
      "description": "What this actually is, in plain English, for a reader who is not a specialist in this field. No jargon that is not immediately explained."
    },
    "pillar": {
      "enum": [
        "ai",
        "quantum",
        "materials",
        "energy",
        "cyber"
      ]
    },
    "readiness": {
      "enum": [
        "emerging",
        "experimental",
        "demonstrated",
        "adopted",
        "mainstream"
      ],
      "description": "Top to bottom. Things fall toward reality. Scale is defined per pillar in content/frontier/_scales.json."
    },
    "constellation": {
      "type": "string"
    },
    "cluster": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who demonstrated or published this. A facet, not a category \u2014 organisations do not have readiness levels."
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Typed relationships to other frontier items. Drives the drawn constellation lines.",
      "items": {
        "type": "object",
        "required": [
          "to",
          "relation"
        ],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "depends-on",
              "competes-with",
              "enables",
              "supersedes",
              "evidence-for"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "sources",
        "claim",
        "verified"
      ],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "maxLength": 400
        },
        "verified": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "role": {
                "enum": [
                  "primary",
                  "preprint",
                  "standard",
                  "vendor",
                  "corroborating"
                ]
              },
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "moved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "enum": [
            "emerging",
            "experimental",
            "demonstrated",
            "adopted",
            "mainstream"
          ]
        },
        "on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "enum": [
        "human",
        "agent"
      ],
      "default": "human"
    },
    "added": {
      "type": "string",
      "format": "date"
    }
  }
}
