{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://horizonqltd.com/schema/frontier/v1",
  "title": "Horizon Q frontier item",
  "description": "One development on the frontier. Position is derived from readiness; nothing here stores coordinates. No item exists without a source.",
  "type": "object",
  "required": [
    "confidence",
    "evidence",
    "id",
    "pillar",
    "readiness",
    "review",
    "schema",
    "status",
    "title"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "frontier/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "summary": {
      "type": "string",
      "maxLength": 300
    },
    "plain": {
      "type": "string",
      "maxLength": 600,
      "description": "What this actually is, in plain English, for a reader who is not a specialist in this field. No jargon that is not immediately explained."
    },
    "pillar": {
      "enum": [
        "ai",
        "quantum",
        "materials",
        "energy",
        "cyber"
      ]
    },
    "readiness": {
      "enum": [
        "emerging",
        "experimental",
        "demonstrated",
        "adopted",
        "mainstream"
      ],
      "description": "Top to bottom. Things fall toward reality. Scale is defined per pillar in content/frontier/_scales.json."
    },
    "constellation": {
      "enum": [
        "architectures",
        "error-correction",
        "algorithms",
        "enabling",
        "pqc",
        "migration",
        "communications",
        "sensing",
        "applications"
      ],
      "description": "Constrained rather than free text: a typo used to place an item in the wrong lane silently. An unknown constellation now fails the build."
    },
    "cluster": {
      "type": "string"
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Who demonstrated or published this. A facet, not a category \u2014 organisations do not have readiness levels."
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "description": "Typed relationships to other frontier items. Drives the drawn constellation lines.",
      "items": {
        "type": "object",
        "required": [
          "to",
          "relation"
        ],
        "additionalProperties": false,
        "properties": {
          "to": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "depends-on",
              "competes-with",
              "enables",
              "supersedes",
              "evidence-for"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "sources",
        "claim",
        "verified",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "type": "string",
          "maxLength": 400
        },
        "verified": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "role": {
                "enum": [
                  "primary",
                  "preprint",
                  "standard",
                  "vendor",
                  "corroborating"
                ]
              },
              "title": {
                "type": "string"
              },
              "publisher": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "identifier": {
                "type": "string"
              },
              "doi": {
                "type": "string",
                "description": "Digital object identifier, without the https://doi.org/ prefix."
              },
              "note": {
                "type": "string",
                "maxLength": 200,
                "description": "Anything a reader needs to know about this source specifically."
              },
              "accessed": {
                "type": "string",
                "description": "Date the URL was last opened."
              }
            }
          }
        },
        "level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ],
          "description": "E5 replicated/independently validated \u00b7 E4 peer-reviewed, not replicated \u00b7 E3 preprint or credible lab demo \u00b7 E2 prototype or vendor technical claim \u00b7 E1 proposal/theory \u00b7 E0 speculative. Never discard E0/E1 for being speculative \u2014 label them."
        }
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "moved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "enum": [
            "emerging",
            "experimental",
            "demonstrated",
            "adopted",
            "mainstream"
          ]
        },
        "on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "enum": [
        "human",
        "agent"
      ],
      "default": "human"
    },
    "added": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "description": "What the board should pull the eye to. Set by the final test: if this were true and scaled, what assumption would have to change? If none, P3 or P4. Significance, never publicity."
    },
    "qdayImpact": {
      "type": "integer",
      "minimum": -3,
      "maximum": 3,
      "description": "Quantum only. +3 could significantly accelerate Q-Day, 0 no credible effect, -3 strong evidence current forecasts are over-optimistic."
    },
    "qdayReasoning": {
      "type": "string",
      "maxLength": 500,
      "description": "Required whenever qdayImpact is not 0. A score without reasoning is an opinion."
    },
    "country": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Where the work was done. Makes the English-language coverage gap measurable rather than merely admitted."
    },
    "novelty": {
      "type": "string",
      "maxLength": 60,
      "description": "Free tag, not a scored axis. e.g. major breakthrough, new architecture, incremental."
    },
    "horizon": {
      "enum": [
        1,
        2,
        3
      ],
      "description": "1 mainstream 0-3y \u00b7 2 emerging lab/prototype 3-10y \u00b7 3 frontier/blue sky."
    },
    "review": {
      "type": "object",
      "description": "Provenance. Every item declares whether a human has read it. An agent writes agent-merged and cannot write reviewed \u2014 that is the whole safeguard.",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "reviewed",
            "agent-merged",
            "vetoed"
          ],
          "description": "reviewed = a human read it \u00b7 agent-merged = published by an agent, not yet read \u00b7 vetoed = reverted, kept for the record"
        },
        "by": {
          "enum": [
            "human",
            "agent"
          ],
          "description": "Who last set this state."
        },
        "on": {
          "type": "string",
          "format": "date",
          "description": "Date the state was set."
        },
        "agentMergedOn": {
          "type": "string",
          "format": "date",
          "description": "When an agent published it. Retained after review so the history stays legible."
        },
        "agent": {
          "type": "string",
          "description": "Which agent, when agent-merged."
        },
        "note": {
          "type": "string",
          "maxLength": 300
        }
      }
    }
  }
}
