{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://horizonqltd.com/schema/forecast/v1",
  "title": "Forecast",
  "description": "A dated estimate the rest of the board is measured against — currently just Q-Day. Agents may move it within guardrails (one axis at a time, a two-year cap, evidence required) and it is stamped agent-estimate when they do; only a human can write state: human-set.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "pillar",
    "title",
    "question",
    "estimates",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "forecast/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "pillar": {
      "enum": [
        "ai",
        "quantum",
        "materials",
        "energy",
        "cyber"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "question": {
      "type": "string",
      "maxLength": 300
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "description": "Years. Missing axes are legitimately unset, not zero.",
      "properties": {
        "earliest": { "type": "number" },
        "aggressive": { "type": "number" },
        "central": { "type": "number" },
        "conservative": { "type": "number" }
      }
    },
    "state": {
      "enum": [
        "human-set",
        "agent-estimate"
      ],
      "description": "An agent may write agent-estimate and can never write human-set."
    },
    "by": {
      "enum": [
        "human",
        "agent"
      ]
    },
    "on": {
      "type": "string",
      "format": "date"
    },
    "lastHumanReview": {
      "type": "string",
      "format": "date"
    },
    "note": {
      "type": "string",
      "maxLength": 600
    },
    "log": {
      "type": "array",
      "maxItems": 40,
      "description": "Every movement of the estimate, most recent first.",
      "items": {
        "type": "object",
        "required": [
          "date",
          "from",
          "to",
          "by",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "from": {
            "type": "string",
            "maxLength": 40
          },
          "to": {
            "type": "string",
            "maxLength": 40
          },
          "by": {
            "enum": [
              "human",
              "agent"
            ]
          },
          "agent": {
            "type": "string"
          },
          "evidence": {
            "type": "string",
            "maxLength": 600
          },
          "assumption": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  }
}
